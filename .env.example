# ----------------------------- App ------------------------------
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]

# ---------------------------- Database --------------------------
# Dev: sqlite (default).  Prod (Railway): postgres.
DATABASE_URL=sqlite+aiosqlite:///./db/recruitai.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/recruitai

# ---------------------------- Security --------------------------
JWT_SECRET_KEY=change-this-32-chars-minimum-secret
ADMIN_SECRET_KEY=admin-secret-key

# ---------------------------- Storage ---------------------------
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./uploads
SIGNED_URL_BASE=http://localhost:8000
SIGNED_URL_SECRET=local-secret-for-signed-urls

# ----------------------------- LLM ------------------------------
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-model
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --------------------------- Email (Resend) ---------------------
RESEND_API_KEY=
EMAIL_FROM=RecruitAI <noreply@recruitai.app>

# --------------------------- Stripe -----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --------------------------- Frontend ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
